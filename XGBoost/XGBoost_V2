import pandas as pd
import numpy as np
from xgboost import XGBRegressor
from sklearn.metrics import mean_absolute_error
import matplotlib.pyplot as plt
import random

# === Load and clean data ===
df = pd.read_excel("/Users/samet/INDR491CodeBase/indr491-1/preprocessedBelgeler/zero_filled_forecastData_altLimit100_son3_byGrup.xlsx.xlsx")
df["Sipariş Mik. (TON)"] = (
    df["Sipariş Mik. (TON)"]
    .astype(str)
    .str.replace(",", ".", regex=False)
    .astype(float)
)
df["Month"] = pd.to_datetime(df["Month"], errors='coerce')
df["month"] = df["Month"].dt.month
df["year"] = df["Month"].dt.year
df = df.dropna(subset=["Month"])

# === Sort by time and group ===
df = df.sort_values(by=["SpecGroupId", "Month"]).reset_index(drop=True)

# === Feature Engineering (no Grade used) ===
df["lag_1"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].shift(1)
df["lag_2"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].shift(2)
df["lag_3"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].shift(3)
df["lag_6"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].shift(6)
df["prev_year_same_month"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].shift(12)

df["rolling_mean_3"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].transform(lambda x: x.shift(1).rolling(3).mean())
df["rolling_mean_6"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].transform(lambda x: x.shift(1).rolling(6).mean())
df["rolling_std_3"] = df.groupby("SpecGroupId")["Sipariş Mik. (TON)"].transform(lambda x: x.shift(1).rolling(3).std())

df["quarter"] = df["Month"].dt.quarter
df["is_start_of_year"] = (df["Month"].dt.month == 1).astype(int)

df_model = df.dropna().copy()

# === Define Features ===
features = [
    "SpecGroupId", "month", "year", "quarter", "is_start_of_year",
    "lag_1", "lag_2", "lag_3", "lag_6",
    "rolling_mean_3", "rolling_mean_6", "rolling_std_3", "prev_year_same_month"
]
target = "Sipariş Mik. (TON)"

# === Split train/test per SpecGroupId (12 months as test) ===
train_rows = []
test_rows = []

for group_id, group_df in df_model.groupby("SpecGroupId"):
    group_df = group_df.sort_values("Month")
    if len(group_df) < 24:
        continue  # skip if not enough data
    split_point = group_df["Month"].unique()[-12]  # last 12 months as test
    train_rows.append(group_df[group_df["Month"] < split_point])
    test_rows.append(group_df[group_df["Month"] >= split_point])

train_df = pd.concat(train_rows)
test_df = pd.concat(test_rows)

X_train = train_df[features]
y_train = train_df[target]
X_test = test_df[features]
y_test = test_df[target]

# === Train Model ===
model = XGBRegressor(
    objective="reg:squarederror",
    n_estimators=100,
    learning_rate=0.1,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42
)
model.fit(X_train, y_train)

# === Evaluate ===
y_pred = model.predict(X_test)
mae = mean_absolute_error(y_test, y_pred)
print(f"MAE: {mae:.2f}")

def mean_absolute_percentage_error(y_true, y_pred):
    y_true, y_pred = np.array(y_true), np.array(y_pred)
    nonzero = y_true != 0
    return np.mean(np.abs((y_true[nonzero] - y_pred[nonzero]) / y_true[nonzero])) * 100

mape = mean_absolute_percentage_error(y_test, y_pred)
print(f"MAPE: {mape:.2f}% average percentage error")

# === Plot: Top 6 highest demand groups ===
top_ids = df_model.groupby("SpecGroupId")[target].sum().sort_values(ascending=False).head(20).index
top_test_ids = list(set(top_ids) & set(test_df["SpecGroupId"].unique()))
sample_ids = random.sample(top_test_ids, k=min(6, len(top_test_ids)))

fig, axes = plt.subplots(2, 3, figsize=(18, 8))
axes = axes.flatten()

test_df = test_df.copy()
test_df["y_pred"] = y_pred

for i, sg_id in enumerate(sample_ids):
    ax = axes[i]
    full = df_model[df_model["SpecGroupId"] == sg_id]
    train_grp = train_df[train_df["SpecGroupId"] == sg_id]
    test_grp = test_df[test_df["SpecGroupId"] == sg_id]

    ax.plot(train_grp["Month"], train_grp[target], label="Train Actual", marker="o", color="blue")
    ax.plot(test_grp["Month"], test_grp[target], label="Test Actual", marker="o", color="green")
    ax.plot(test_grp["Month"], test_grp["y_pred"], label="Forecast", linestyle="--", marker="x", color="orange")

    if not test_grp.empty:
        ax.axvline(test_grp["Month"].min(), color="red", linestyle="dotted", label="Train/Test Split")

    ax.set_title(f"SpecGroupId: {sg_id}")
    ax.set_xlabel("Month")
    ax.set_ylabel("TON")
    ax.grid(True)

axes[0].legend()
plt.tight_layout()
plt.show()
